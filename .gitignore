bin/
# Git hooks and editor noise
**/*.rs.bk
**/*.swp
**/*.swo
**/*.swn
**/*.iml
**/*.sublime-workspace
**/.DS_Store
# Local developer environment overrides (keep .env.example tracked)
.env.local
.env.**
# Environment/tool artifacts (agent/plugin dependencies, not project source)
node_modules/
node_modules/*/
.operator/
# Local-only private credentials or runtime config
credentials/
secrets/
config/local/
